# --- App ---
APP_ENV=development            # development | production | test
DATABASE_URL=sqlite:///./smart_email.db
# PostgreSQL (production): postgresql+psycopg://user:password@localhost:5432/smart_email
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120

# --- Mode ---
DEMO_MODE=true                 # true = mock mailbox, sends are simulated. false = real Gmail

# --- LLM (Google AI Studio) ---
LLM_PROVIDER=auto              # auto = Gemini if GEMINI_API_KEY is set, else offline mock | gemini | mock
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash  # any model id available in your AI Studio account

# --- Google OAuth (only needed when DEMO_MODE=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Required in production. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
